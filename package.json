{
    "name": "@ironflock/widget-textbox",
    "description": "Webcomponent widget-textbox following open-wc recommendations",
    "license": "MIT",
    "author": "widget-textbox",
    "version": "1.1.14",
    "engines": {
        "node": ">=24.9.0",
        "npm": ">=10.0.2"
    },
    "type": "module",
    "main": "dist/widget-textbox.js",
    "types": "dist/src/widget-textbox.d.ts",
    "files": [
        "dist",
        "src",
        "thumbnail.png",
        "thumbnail.webp"
    ],
    "scripts": {
        "start": "concurrently -k -r \"npm run watch\" \"wds\"",
        "build": "rollup -c rollup.config.js",
        "watch": "rollup -w -c rollup.config.js",
        "link": "npm link && cd ../RESWARM/frontend && npm link @ironflock/widget-textbox",
        "unlink": "npm unlink --global && cd ../RESWARM/frontend && npm unlink @ironflock/widget-textbox && npm i @ironflock/widget-textbox",
        "types": "cat src/definition-schema.json | json2ts > src/definition-schema.d.ts"
    },
    "dependencies": {
        "lit": "^3.3.1"
    },
    "devDependencies": {
        "@rollup/plugin-babel": "^6.0.4",
        "@rollup/plugin-commonjs": "^28.0.6",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-replace": "^6.0.2",
        "@rollup/plugin-typescript": "^12.1.3",
        "@web/dev-server": "^0.4.6",
        "concurrently": "^9.1.2",
        "json-schema-to-typescript": "^15.0.4",
        "tslib": "^2.8.1",
        "typescript": "^5.8.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/IronFlock/widget-textbox.git"
    },
    "keywords": [
        "widget",
        "textbox"
    ],
    "bugs": {
        "url": "https://github.com/IronFlock/widget-textbox/issues"
    },
    "homepage": "https://github.com/IronFlock/widget-textbox#readme"
}
